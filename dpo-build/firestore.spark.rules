rules_version = '2';
// Spark: no physical deletions. Annulment preserves all sibling records.
// remisionControls/{id}: version/counts integers, collection/recordId/revision describe the fenced write.
// annulOperations/{id}: immutable actor/role/time/reason, 1–2 confirmed ids and omitted results.
// Legacy controls: trusted technical initialization while dependent writes are frozen.
// deadlineDays is published by a trusted administrative calendar procedure, not by clients.
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.email_verified == true; }
  function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function role(r) { return signed() && profile().active == true && profile().role == r; }
  function readScope(g) { return signed() && profile().active == true && (profile().role in ['director','technical'] || (profile().role == 'asistente' && g in profile().gerencias) || (profile().role == 'gerente' && profile().gerenciaId == g)); }
  function writeScope(g) { let p=profile(); return signed() && p.active && (p.role == 'technical' || p.role == 'asistente' && g in p.gerencias); }
  function lotWrite(g) { let p=profile(); return signed() && p.active && (p.role in ['technical','director'] || p.role == 'gerente' && p.gerenciaId == g || p.role == 'asistente' && g in p.gerencias); }
  function entityWrite(g,c) { return c == 'lotes' ? lotWrite(g) : writeScope(g); }
  function ident(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$'); }
  function text(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function part(v) { return v.matches('^\\S(.*\\S)?$') && text(v,150) && !v.matches('.*[/|].*'); }
  function civil(v) { let a=v.split('-'); let t=timestamp.date(int(a[0]),int(a[1]),int(a[2])); return v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && t.year() >= 2000 && t.year() <= 2100 && t.month() == int(a[1]) && t.day() == int(a[2]); }
  function parent(g,c,id) { return get(/databases/$(database)/documents/gerencias/$(g)/$(c)/$(id)).data; }
  function existsParent(g,c,id) { return ident(id) && exists(/databases/$(database)/documents/gerencias/$(g)/$(c)/$(id)); }
  function key(c,r,g) {
   return c == 'gerencias' ? c+'|'+r.name.lower()
    : c == 'cacs' ? c+'|'+r.gerenciaId+'|'+r.name.lower()
    : c == 'remisiones' ? c+'|'+r.cacId+'|'+string(r.year)+'|'+string(r.month)+'|'+string(r.half)
    : c == 'lotes' ? ('typeId' in r ? typedLotKey(g,r) : c+'|'+r.remisionId+'|'+r.code.lower())
    : c == 'documentos' ? c+'|'+r.loteId+'|'+r.type.lower()+'|'+r.number.lower()
    : c+'|'+r.id;
  }
  function locked(g,c,r,path) { return r.uniqueKey == key(c,r,g) && getAfter(/databases/$(database)/documents/sparkKeys/$(r.uniqueKey)).data == { 'path':path,'gerenciaId':g,'entity':c,'recordId':r.id }; }
  function audited(g,c,id,r) {
   let a = getAfter(/databases/$(database)/documents/gerencias/$(g)/audit/$(c+'_'+id+'_'+string(r.revision))).data;
   return a.actor == request.auth.uid && a.at == request.time && a.after == r;
  }
  function basic(g,c,id,r,path) {
   return ident(id) && r.id == id && r.revision is int && r.revision > 0 && r.updatedAt == request.time
     && locked(g,c,r,path) && audited(g,c,id,r) && getAfter(/databases/$(database)/documents/sparkIds/$(c+'_'+id)).data.gerenciaId == g;
  }
  function schema(g,c,r) {
   return c == 'cacs' ? r.keys().hasOnly(['id','name','gerenciaId','active','contacto','revision','updatedAt','uniqueKey']) && r.get('active',true) is bool && part(r.name) && r.gerenciaId == g && (!('contacto' in r) || contact(r.contacto))
    : c == 'remisiones' ? r.keys().hasOnly(['id','cacId','year','month','half','receivedOn','expediente','remittedOn','originalDueOn','dueOn','calendarVersion','businessDays','timeZone','revision','updatedAt','uniqueKey','origin','annulment'])
       && r.get('origin','unknown') in ['unknown','manual','automatic']
       && existsParent(g,'cacs',r.cacId) && r.year is int && r.year >= 2000 && r.year <= 2100 && r.month is int && r.month >= 1 && r.month <= 12 && r.half in [1,2]
       && ((!('expediente' in r) && !('remittedOn' in r)) || text(r.expediente,150) && civil(r.remittedOn) && r.remittedOn <= r.receivedOn)
       && text(r.receivedOn,10) && text(r.dueOn,10) && text(r.originalDueOn,10) && ident(r.calendarVersion) && r.businessDays == 10 && r.timeZone == 'America/Asuncion'
    : c == 'lotes' ? r.keys().hasOnly(['id','remisionId','code','declared','revision','updatedAt','uniqueKey','typeId','typeCode','typeRequired','catalogVersion','sequence','cacCode']) && existsParent(g,'remisiones',r.remisionId) && part(r.code) && r.declared is int && r.declared >= 0 && r.declared <= 1000000
    : c == 'documentos' ? r.keys().hasOnly(['id','loteId','type','number','state','firstObservationId','revision','updatedAt','uniqueKey']) && existsParent(g,'lotes',r.loteId) && part(r.type) && part(r.number) && (!('typeId' in parent(g,'lotes',r.loteId)) || r.type == parent(g,'lotes',r.loteId).typeCode)
      && r.state in ['Pendiente','Verificado','Verificado con observación','Rechazado'] && r.firstObservationId is string && r.firstObservationId.size() <= 128
      && (r.firstObservationId == '' ? r.state != 'Verificado con observación' : ident(r.firstObservationId) && r.state == 'Verificado con observación' && getAfter(/databases/$(database)/documents/gerencias/$(g)/observaciones/$(r.firstObservationId)).data.documentId == r.id)
    : c == 'observaciones' && r.keys().hasOnly(['id','documentId','description','date','owner','status','revision','updatedAt','uniqueKey']) && existsParent(g,'documentos',r.documentId)
       && text(r.description,2000) && text(r.owner,150) && r.date is string && civil(r.date) && r.status in ['Pendiente','En proceso','Regularizada']
       && getAfter(/databases/$(database)/documents/gerencias/$(g)/documentos/$(r.documentId)).data.state == 'Verificado con observación';
  }
  function stable(c,r,b) {
   return c == 'cacs' ? r.gerenciaId == b.gerenciaId
    : c == 'remisiones' ? r.cacId == b.cacId && r.year == b.year && r.month == b.month && r.half == b.half && r.receivedOn == b.receivedOn && r.dueOn == b.dueOn && r.originalDueOn == b.originalDueOn && r.calendarVersion == b.calendarVersion && r.get('origin','unknown') == b.get('origin','unknown')
    : c == 'lotes' ? r.remisionId == b.remisionId && (!('typeId' in b) ? !('typeId' in r) : r.diff(b).affectedKeys().hasOnly(['declared','revision','updatedAt']))
    : c == 'documentos' ? r.loteId == b.loteId && (b.firstObservationId == '' || r.firstObservationId == b.firstObservationId)
    : r.documentId == b.documentId;
  }

  function controlPath(g,r) { return /databases/$(database)/documents/gerencias/$(g)/remisionControls/$(r); }
  function rootId(g,c,r) {
    return c == 'remisiones' ? r.id : c == 'lotes' ? r.remisionId
      : c == 'documentos' ? parent(g,'lotes',r.loteId).remisionId
      : parent(g,'lotes',parent(g,'documentos',r.documentId).loteId).remisionId;
  }
  function fenced(g,c,r,creating) {
    let rid=rootId(g,c,r);
    let cp=controlPath(g,rid);
    let next=getAfter(cp).data;
    return (c == 'remisiones' && creating ? next.version == 1 : next.version == get(cp).data.version + 1)
      && (c == 'remisiones' && creating || parent(g,'remisiones',rid).get('annulment',null) == null)
      && getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(rid)).data.get('annulment',null) == null
      && (!creating || next.collection == c && next.recordId == r.id);
  }
  function operational(g,c,r,creating) {
    return c == 'cacs' || fenced(g,c,r,creating) && (c != 'remisiones' || r.get('annulment',null) == null);
  }
  function canAnnul(g,control) {
    return role('technical') || control.lots == 0 && (role('director') || role('gerente') && profile().gerenciaId == g);
  }
  function annulChange(g,id,r,b) {
    let a=r.annulment;
    let cp=controlPath(g,id);
    let control=get(cp).data;
    let next=getAfter(cp).data;
    let op=getAfter(/databases/$(database)/documents/gerencias/$(g)/annulOperations/$(a.operationId)).data;
    let preview=get(/databases/$(database)/documents/gerencias/$(g)/annulPreviews/$(a.operationId)).data;
    return b.get('annulment',null) == null && canAnnul(g,control)
      && preview.actor == request.auth.uid && request.time <= preview.at + duration.value(5,'m')
      && preview.versions[id].revision == b.revision && preview.versions[id].controlVersion == control.version
      && r.diff(b).affectedKeys().hasOnly(['annulment','revision','updatedAt'])
      && a.keys().hasAll(['operationId','actor','role','at','reason','lots','documents','observations'])
      && a.keys().hasOnly(['operationId','actor','role','at','reason','lots','documents','observations'])
      && ident(a.operationId) && a.actor == request.auth.uid && a.role == profile().role && a.at == request.time && text(a.reason,2000)
      && a.lots == control.lots && a.documents == control.documents && a.observations == control.observations
      && next.version == control.version + 1 && next.collection == 'annulment' && next.recordId == id
      && id in op.ids && op.actor == request.auth.uid && op.at == request.time && op.reason == a.reason;
  }
  function receipt(r) {
   let d = get(/databases/$(database)/documents/deadlineDays/$(r.calendarVersion+'_'+r.receivedOn)).data;
   return r.calendarVersion == get(/databases/$(database)/documents/settings/calendar).data.version && r.originalDueOn == d.originalDueOn && r.dueOn == d.dueOn && r.receivedOn <= string(request.time.year())+'-'+(request.time.month()<10?'0':'')+string(request.time.month())+'-'+(request.time.day()<10?'0':'')+string(request.time.day());
  }
  function contact(c) {
   return c is map && c.keys().hasAll(['nombre','cargo','correo','interno','celular']) && c.keys().hasOnly(['nombre','cargo','correo','interno','celular'])
    && text(c.nombre,150) && text(c.cargo,150) && text(c.correo,254) && c.correo.matches('^[^ @]+@[^ @]+[.][^ @]+$')
    && c.interno is string && c.interno.matches('^[0-9 +().-]{1,20}$') && c.interno.matches('.*[0-9].*')
    && c.celular is string && c.celular.matches('^[0-9 +().-]{6,30}$') && c.celular.matches('.*[0-9].*');
  }
  function contacts(r) {return r.responsables is list && r.responsables.size()==2 && contact(r.responsables[0]) && contact(r.responsables[1]) && r.responsables[0].correo.lower()!=r.responsables[1].correo.lower();}
  function typedLotKey(g,r) {
    let rem=parent(g,'remisiones',r.remisionId);
    return 'typed|'+g+'|'+rem.cacId+'|'+string(rem.year)+'|'+string(rem.month)+'|'+string(rem.half)+'|'+r.typeId;
  }
  function newTypedLot(g,id,r) {
    let rem=parent(g,'remisiones',r.remisionId);
    let cac=parent(g,'cacs',rem.cacId);
    let catalog=get(/databases/$(database)/documents/documentCatalog/current).data;
    let version=get(/databases/$(database)/documents/documentCatalogVersions/$(string(r.catalogVersion))).data;
    let req=getAfter(/databases/$(database)/documents/gerencias/$(g)/lotRequirements/$(r.remisionId)).data;
    let seq=getAfter(/databases/$(database)/documents/gerencias/$(g)/lotSequences/$(rem.cacId+'_'+string(rem.year)+'_'+string(rem.half))).data;
    let control=getAfter(controlPath(g,r.remisionId)).data;
    return lotWrite(g) && ident(id) && r.id == id && r.revision == 1 && r.updatedAt == request.time
     && getAfter(/databases/$(database)/documents/sparkIds/$('lotes_'+id)).data == {'gerenciaId':g,'entity':'lotes','recordId':id}
     && schema(g,'lotes',r) && rem.get('annulment',null) == null && cac.get('active',true)
     && catalog.types.keys().hasAll(['SCA','RES','CON','REC66']) && catalog.types[r.typeId].enabled && r.typeCode == catalog.types[r.typeId].code
     && version.types[r.typeId].enabled && r.typeRequired == version.types[r.typeId].required && req.catalogVersion == r.catalogVersion
     && r.sequence is int && r.sequence > 0 && seq.value == r.sequence && seq.lotId == id && seq.updatedAt == request.time
     && r.cacCode == cac.name.split(' - ')[0]
     && r.code == 'LOT_'+(r.sequence < 10 ? '0' : '')+string(r.sequence)+'_'+r.typeCode+'_'+r.cacCode+'_'+string(rem.year)+'_'+string(rem.half)
     && control.collection == 'lotes' && control.recordId == id && control.updatedAt == request.time
     && locked(g,'lotes',r,'gerencias/'+g+'/lotes/'+id) && audited(g,'lotes',id,r);
  }
  function catalogManager() { return role('director') || role('technical'); }
  function validCatalog(c) {
    let t=c.types[c.changedId];
    return c.keys().hasOnly(['revision','types','changedId','actor','updatedAt']) && c.revision is int && c.revision > 0
     && c.actor == request.auth.uid && c.updatedAt == request.time && c.types is map && c.types.size() <= 100
     && t.keys().hasOnly(['id','code','description','required','enabled','order']) && t.id == c.changedId && t.code == c.changedId
     && t.code.matches('^[A-Za-z0-9_-]{1,40}$') && text(t.description,200) && t.required is bool && t.enabled is bool && t.order is int && t.order >= 0 && t.order <= 10000
     && (!(t.code in ['SCA','RES','CON','REC66']) || t.required && t.enabled)
     && getAfter(/databases/$(database)/documents/documentCatalogVersions/$(string(c.revision))).data == c
     && getAfter(/databases/$(database)/documents/catalogAudit/$(string(c.revision))).data.after == t;
  }
  match /documentCatalog/current {
    allow read: if signed() && profile().active;
    allow create: if catalogManager() && validCatalog(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.types.size() == 1;
    allow update: if catalogManager() && validCatalog(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.types.diff(resource.data.types).affectedKeys().hasOnly([request.resource.data.changedId])
     && request.resource.data.types.diff(resource.data.types).removedKeys().size() == 0;
  }
  match /documentCatalogVersions/{v} {
    allow read: if signed() && profile().active;
    allow create: if catalogManager() && v == string(request.resource.data.revision) && getAfter(/databases/$(database)/documents/documentCatalog/current).data == request.resource.data && request.resource.data.updatedAt == request.time;
  }
  match /catalogAudit/{v} {
    allow read: if catalogManager();
    allow create: if catalogManager() && request.resource.data.keys().hasOnly(['revision','actor','role','at','reason','before','after'])
     && request.resource.data.actor == request.auth.uid && request.resource.data.role == profile().role && request.resource.data.at == request.time && text(request.resource.data.reason,2000)
     && v == string(request.resource.data.revision) && getAfter(/databases/$(database)/documents/documentCatalog/current).data.revision == request.resource.data.revision
     && request.resource.data.after == getAfter(/databases/$(database)/documents/documentCatalog/current).data.types[request.resource.data.after.id]
     && request.resource.data.before == (exists(/databases/$(database)/documents/documentCatalog/current) ? get(/databases/$(database)/documents/documentCatalog/current).data.types.get(request.resource.data.after.id,null) : null);
  }
  match /gerencias/{g} {
   allow read: if readScope(g);
   allow create, update: if role('technical') && request.resource.data.keys().hasOnly(['id','name','responsables','revision','scopeRevision','updatedAt','uniqueKey'])
    && part(request.resource.data.name) && contacts(request.resource.data) && request.resource.data.scopeRevision == 0
    && basic(g,'gerencias',g,request.resource.data,'gerencias/'+g)
    && (resource == null ? request.resource.data.revision == 1 : request.resource.data.revision == resource.data.revision + 1);
   match /{c}/{id} {
    allow read: if c in ['cacs','remisiones','lotes','documentos','observaciones','audit'] && readScope(g) && exists(/databases/$(database)/documents/gerencias/$(g));
    allow create: if c in ['cacs','remisiones','lotes','documentos','observaciones'] && entityWrite(g,c) && (c != 'cacs' || role('technical')) && exists(/databases/$(database)/documents/gerencias/$(g))
      && (c != 'lotes' || !exists(/databases/$(database)/documents/documentCatalog/current) && !('typeId' in request.resource.data))
      && operational(g,c,request.resource.data,true) && basic(g,c,id,request.resource.data,'gerencias/'+g+'/'+c+'/'+id) && schema(g,c,request.resource.data) && request.resource.data.revision == 1
      && (c != 'remisiones' || receipt(request.resource.data) && get(/databases/$(database)/documents/gerencias/$(g)/cacs/$(request.resource.data.cacId)).data.get('active',true) == true);
    allow update: if c in ['cacs','remisiones','lotes','documentos','observaciones'] && (entityWrite(g,c) && (c != 'cacs' || role('technical')) || role('director') && c == 'cacs' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','revision','updatedAt'])) && exists(/databases/$(database)/documents/gerencias/$(g))
      && operational(g,c,request.resource.data,false) && basic(g,c,id,request.resource.data,'gerencias/'+g+'/'+c+'/'+id) && schema(g,c,request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && stable(c,request.resource.data,resource.data);
   }
   match /lotes/{id} {
    allow create: if newTypedLot(g,id,request.resource.data);
   }
   // Immutable signed review; quantities are the authorized reviewer's attestation.
   // Inventory is recalculated by the client, fenced against concurrent operational writes.
   match /lotVerificationComments/{id} {
    allow read: if readScope(g);
    allow create: if lotWrite(g) && validComment(request.resource.data);
    function validComment(v){
     let review=get(/databases/$(database)/documents/gerencias/$(g)/lotVerifications/$(v.verificationId)).data;
     return v.keys().hasAll(['id','lotId','verificationId','comments','actor','role','at'])
      && v.keys().hasOnly(['id','lotId','verificationId','comments','actor','role','at'])
      && ident(id) && v.id==id && ident(v.lotId) && ident(v.verificationId)
      && review.lotId==v.lotId && review.result=='Verificado'
      && text(v.comments,2000) && v.actor==request.auth.uid && v.role==profile().role && v.at==request.time;
    }
   }
   match /lotVerifications/{id} {
    allow read: if readScope(g);
    allow create: if role('technical') && validVerification(request.resource.data);
    function validVerification(v) {
     let l=get(/databases/$(database)/documents/gerencias/$(g)/lotes/$(v.lotId)).data;
     let r=get(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(l.remisionId)).data;
     let c=get(/databases/$(database)/documents/gerencias/$(g)/remisionControls/$(l.remisionId)).data;
     return v.keys().hasAll(['id','lotId','code','remisionId','lotRevision','controlVersion','actor','role','at','declared','registered','missing','excess','openObservations','confirmed','result','comments','reviewerComments'])
      && v.keys().hasOnly(['id','lotId','code','remisionId','lotRevision','controlVersion','actor','role','at','declared','registered','missing','excess','openObservations','confirmed','result','comments','reviewerComments','individualized','countSource'])
      && ident(id) && v.id == id && ident(v.lotId) && v.code == l.code && v.remisionId == l.remisionId
      && r.get('annulment',null) == null && v.lotRevision == l.revision && v.controlVersion == c.version
      && v.actor == request.auth.uid && v.role == profile().role && v.at == request.time
      && v.declared == l.declared && v.registered is int && v.registered >= 0 && v.registered <= 1000000
      && ((!('countSource' in v) && !('individualized' in v) && v.registered <= 3000) || (v.countSource == 'manual' && v.individualized is int && v.individualized >= 0 && v.individualized <= 3000))
      && v.openObservations is int && v.openObservations >= 0 && v.openObservations <= 3000
      && v.missing == (v.declared > v.registered ? v.declared-v.registered : 0)
      && v.excess == (v.registered > v.declared ? v.registered-v.declared : 0)
      && v.confirmed is bool && v.comments is string && v.comments.size() <= 2000
      && v.reviewerComments is string && v.reviewerComments.size() <= 2000
      && (v.confirmed ? v.result == 'Verificado' && v.declared > 0 && v.registered == v.declared && v.openObservations == 0 && v.comments == 'Presentación sin inconvenientes, lote completo'
        : v.result == 'Con observaciones' && text(v.comments,2000) && v.comments == v.reviewerComments);
    }
   }
   match /lotRequirements/{id} {
    allow read: if readScope(g);
    allow create: if lotWrite(g) && request.resource.data.keys().hasOnly(['id','catalogVersion','actor','at']) && request.resource.data.id == id
     && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
     && request.resource.data.catalogVersion == get(/databases/$(database)/documents/documentCatalog/current).data.revision
     && get(controlPath(g,id)).data.lots == 0 && parent(g,'remisiones',id).get('annulment',null) == null
     && getAfter(controlPath(g,id)).data.lots == 1;
   }
   match /lotSequences/{id} {
    allow read: if readScope(g);
    function validSequence(r) {
     let lot=getAfter(/databases/$(database)/documents/gerencias/$(g)/lotes/$(r.lotId)).data;
     let rem=parent(g,'remisiones',lot.remisionId);
     return r.keys().hasOnly(['value','lotId','updatedAt']) && r.value == (resource == null ? 1 : resource.data.value+1) && r.updatedAt == request.time
      && !exists(/databases/$(database)/documents/gerencias/$(g)/lotes/$(r.lotId)) && lot.sequence == r.value
      && id == rem.cacId+'_'+string(rem.year)+'_'+string(rem.half);
    }
    allow create, update: if lotWrite(g) && validSequence(request.resource.data);
   }
   match /remisiones/{id} {
    allow update: if readScope(g) && annulChange(g,id,request.resource.data,resource.data)
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.updatedAt == request.time && audited(g,'remisiones',id,request.resource.data);
   }
   match /remisionControls/{id} {
    allow read: if readScope(g);
    function validControl(r) {
      return r.keys().hasAll(['version','lots','documents','observations','collection','recordId','revision','updatedAt'])
       && r.keys().hasOnly(['version','lots','documents','observations','collection','recordId','revision','updatedAt'])
       && r.version is int && r.version > 0 && r.lots is int && r.lots >= 0 && r.documents is int && r.documents >= 0 && r.observations is int && r.observations >= 0
       && ident(r.recordId) && r.revision is int && r.revision > 0 && r.updatedAt == request.time;
    }
    function validAdvance(r) {
      let p=/databases/$(database)/documents/gerencias/$(g)/$(r.collection)/$(r.recordId);
      let saved=getAfter(p).data;
      let added=!exists(p);
      return r.collection in ['remisiones','lotes','documentos','observaciones'] && entityWrite(g,r.collection)
       && rootId(g,r.collection,saved) == id && saved.revision == r.revision && saved.updatedAt == request.time
       && (added || saved.revision == get(p).data.revision + 1)
       && r.lots == resource.data.lots + (r.collection == 'lotes' && added ? 1 : 0)
       && r.documents == resource.data.documents + (r.collection == 'documentos' && added ? 1 : 0)
       && r.observations == resource.data.observations + (r.collection == 'observaciones' && added ? 1 : 0);
    }
    allow create: if validControl(request.resource.data) && request.resource.data.version == 1 && (
      writeScope(g) && request.resource.data.collection == 'remisiones' && request.resource.data.recordId == id
      && !exists(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id))
      && getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id)).data.revision == 1
      && request.resource.data.revision == 1 && request.resource.data.lots == 0 && request.resource.data.documents == 0 && request.resource.data.observations == 0
      || role('technical') && request.resource.data.collection == 'initialization' && request.resource.data.recordId == id
      && parent(g,'remisiones',id).get('annulment',null) == null && request.resource.data.revision == parent(g,'remisiones',id).revision
      && getAfter(/databases/$(database)/documents/gerencias/$(g)/lifecycleAudit/$('init_'+id)).data.control == request.resource.data);
    allow update: if validControl(request.resource.data) && request.resource.data.version == resource.data.version + 1 && (
      request.resource.data.collection != 'annulment' && validAdvance(request.resource.data) || request.resource.data.collection == 'annulment' && request.resource.data.recordId == id
      && request.resource.data.lots == resource.data.lots && request.resource.data.documents == resource.data.documents && request.resource.data.observations == resource.data.observations
      && request.resource.data.revision == getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id)).data.revision
      && parent(g,'remisiones',id).get('annulment',null) == null
      && getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id)).data.annulment.actor == request.auth.uid
      && getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id)).data.annulment.at == request.time);
   }
   match /lifecycleAudit/{event} {
    allow read: if readScope(g);
    allow create: if role('technical') && request.resource.data.keys().hasOnly(['actor','at','reason','remisionId','control'])
      && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time && text(request.resource.data.reason,2000)
      && event == 'init_'+request.resource.data.remisionId && !exists(controlPath(g,request.resource.data.remisionId))
      && getAfter(controlPath(g,request.resource.data.remisionId)).data == request.resource.data.control;
   }
   match /annulPreviews/{operation} {
    allow read: if readScope(g) && resource.data.actor == request.auth.uid;
    allow create: if readScope(g) && profile().role in ['technical','director','gerente']
      && request.resource.data.keys().hasAll(['id','actor','at','versions']) && request.resource.data.keys().hasOnly(['id','actor','at','versions'])
      && ident(operation) && request.resource.data.id == operation && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
      && request.resource.data.versions is map && request.resource.data.versions.size() >= 1 && request.resource.data.versions.size() <= 2;
   }
   match /annulOperations/{operation} {
    allow read: if readScope(g);
    function linked(id) { let a=getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(id)).data.annulment;
      return a.operationId == operation && a.actor == request.auth.uid && a.at == request.time && a.reason == request.resource.data.reason; }
    allow create: if readScope(g) && profile().role in ['technical','director','gerente']
      && request.resource.data.keys().hasOnly(['id','actor','role','at','reason','status','ids','omitted'])
      && request.resource.data.id == operation && ident(operation) && request.resource.data.actor == request.auth.uid && request.resource.data.role == profile().role
      && request.resource.data.at == request.time && text(request.resource.data.reason,2000) && request.resource.data.status == 'completed'
      && request.resource.data.ids is list && request.resource.data.ids.size() >= 1 && request.resource.data.ids.size() <= 2
      && request.resource.data.ids.toSet().size() == request.resource.data.ids.size()
      && request.resource.data.omitted is list && request.resource.data.omitted.size() <= 2
      && linked(request.resource.data.ids[0]) && (request.resource.data.ids.size() == 1 || linked(request.resource.data.ids[1]));
   }
   match /audit/{event} {
    function validAudit() {
     let a = request.resource.data;
     let p = a.collection == 'gerencias' ? /databases/$(database)/documents/gerencias/$(g) : /databases/$(database)/documents/gerencias/$(g)/$(a.collection)/$(a.recordId);
     return a.keys().hasOnly(['id','actor','role','collection','recordId','at','before','after','reason']) && (a.collection == 'lotes' ? a.role == profile().role : !('role' in a) || a.role == profile().role) && a.id == event && a.actor == request.auth.uid && a.at == request.time
       && a.collection in ['gerencias','cacs','remisiones','lotes','documentos','observaciones'] && ident(a.recordId) && text(a.reason,2000)
       && (a.collection != 'remisiones' || a.after.get('annulment',null) == null || a.reason == a.after.annulment.reason)
       && event == a.collection+'_'+a.recordId+'_'+string(a.after.revision) && a.after == getAfter(p).data && (exists(p) ? a.before == get(p).data && a.after.revision == a.before.revision+1 : a.before == null && a.after.revision == 1);
    }
    allow create: if (request.resource.data.collection == 'lotes' && lotWrite(g) || role('director') || writeScope(g) || role('gerente') && profile().gerenciaId == g && request.resource.data.collection == 'remisiones' && getAfter(/databases/$(database)/documents/gerencias/$(g)/remisiones/$(request.resource.data.recordId)).data.annulment.actor == request.auth.uid) && validAudit();
   }
  }
  match /sparkIds/{k} {
   allow get: if signed() && profile().active == true;
   allow create: if (role('director') || entityWrite(request.resource.data.gerenciaId,request.resource.data.entity)) && request.resource.data.keys().hasOnly(['gerenciaId','entity','recordId']) && ident(request.resource.data.gerenciaId) && ident(request.resource.data.recordId) && request.resource.data.entity in ['gerencias','cacs','remisiones','lotes','documentos','observaciones'] && k == request.resource.data.entity+'_'+request.resource.data.recordId
    && getAfter(path('/databases/'+database+'/documents/gerencias/'+request.resource.data.gerenciaId+(request.resource.data.entity == 'gerencias' ? '' : '/'+request.resource.data.entity+'/'+request.resource.data.recordId))).data.id == request.resource.data.recordId;
   allow update: if signed() && profile().active == true && request.resource.data == resource.data;
  }
  match /sparkKeys/{k} {
   allow get: if signed() && profile().active == true && (resource == null || role('director') || readScope(resource.data.gerenciaId));
   allow create, update: if (role('director') || entityWrite(request.resource.data.gerenciaId,request.resource.data.entity))
     && request.resource.data.keys().hasOnly(['path','gerenciaId','entity','recordId']) && ident(request.resource.data.gerenciaId) && ident(request.resource.data.recordId)
     && request.resource.data.entity in ['gerencias','cacs','remisiones','lotes','documentos','observaciones']
     && request.resource.data.path == (request.resource.data.entity == 'gerencias' ? 'gerencias/'+request.resource.data.gerenciaId : 'gerencias/'+request.resource.data.gerenciaId+'/'+request.resource.data.entity+'/'+request.resource.data.recordId)
     && getAfter(path('/databases/'+database+'/documents/'+request.resource.data.path)).data.uniqueKey == k
     && (resource == null || resource.data == request.resource.data);
   allow delete: if (role('director') || entityWrite(resource.data.gerenciaId,resource.data.entity)) && getAfter(path('/databases/'+database+'/documents/'+resource.data.path)).data.uniqueKey != k;
  }
  match /users/{uid} {
   allow get: if signed() && (request.auth.uid == uid || role('technical') || role('director'));
   allow list: if role('technical') || role('director');
   function validProfile(r) {
    return r.keys().hasOnly(['id','role','secondaryRole','description','active','gerencias','gerenciaId','revision']) && r.get('description','') is string && r.get('description','').size() <= 500 && r.id == uid && ident(uid) && r.role in ['director','gerente','asistente','technical'] && (r.role == 'technical' ? r.get('secondaryRole',null) in [null,'director','gerente','asistente'] : r.get('secondaryRole',null) == null) && r.active is bool && r.gerencias is list && r.gerencias.size() <= 20 && r.revision is int && r.revision > 0
     && (r.role == 'gerente' ? ident(r.gerenciaId) && exists(/databases/$(database)/documents/gerencias/$(r.gerenciaId)) : r.gerenciaId == null)
     && (r.role == 'asistente' || r.gerencias.size() == 0);
   }
   function profileAudit(r,kind) { let a = getAfter(/databases/$(database)/documents/administration/$(kind)/audit/$(uid+'_'+string(r.revision))).data; return a.actor == request.auth.uid && a.at == request.time && a.after == r; }
   allow create: if role('technical') && uid != request.auth.uid && exists(/databases/$(database)/documents/accessRequests/$(uid)) && validProfile(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.gerencias.size() == 0 && profileAudit(request.resource.data,'profiles');
   allow update: if uid != request.auth.uid && validProfile(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && (
    role('technical') && request.resource.data.gerencias == (request.resource.data.role == 'asistente' && resource.data.role == 'asistente' ? resource.data.gerencias : []) && profileAudit(request.resource.data,'profiles')
    || (role('director') || role('technical')) && resource.data.role == 'asistente' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gerencias','revision']) && profileAudit(request.resource.data,'assignments'));

  }
  match /accessRequests/{uid} {
   allow get: if signed() && (request.auth.uid == uid || role('technical'));
   allow list: if role('technical');
   allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['id','email','at']) && request.resource.data.id == uid && request.resource.data.email == request.auth.token.email && text(request.resource.data.email,254) && request.resource.data.at == request.time;
  }
  match /settings/{id} {
   allow get: if signed() && profile().active == true && id == 'calendar';
   allow create, update: if (role('director') || role('technical')) && id == 'calendar' && request.resource.data.keys().hasOnly(['version']) && ident(request.resource.data.version) && getAfter(/databases/$(database)/documents/calendars/$(request.resource.data.version)).data.createdAt == request.time;
  }
  match /deadlineDays/{day} {
   allow get: if signed() && profile().active == true;
   // El Director es la autoridad que aprueba la tabla de plazos del calendario.
   allow create: if (role('director') || role('technical')) && request.resource.data.keys().hasOnly(['originalDueOn','dueOn','calendarVersion','businessDays','timeZone']) && ident(request.resource.data.calendarVersion) && civil(request.resource.data.dueOn) && request.resource.data.dueOn == request.resource.data.originalDueOn && request.resource.data.businessDays == 10 && request.resource.data.timeZone == 'America/Asuncion' && day.matches(request.resource.data.calendarVersion+'_[0-9]{4}-[0-9]{2}-[0-9]{2}') && getAfter(/databases/$(database)/documents/calendars/$(request.resource.data.calendarVersion)).data.createdAt == request.time;
  }
  match /calendars/{version} {
   allow get: if signed() && profile().active == true;
   allow create: if (role('director') || role('technical')) && ident(version) && request.resource.data.keys().hasOnly(['version','coverageStart','coverageEnd','approved','holidays','sources','createdAt']) && request.resource.data.version == version && request.resource.data.approved == true && request.resource.data.createdAt == request.time && civil(request.resource.data.coverageStart) && civil(request.resource.data.coverageEnd) && request.resource.data.holidays is list && request.resource.data.holidays.size() <= 400 && request.resource.data.sources is list && request.resource.data.sources.size() > 0 && request.resource.data.sources.size() <= 30 && getAfter(/databases/$(database)/documents/administration/calendars/audit/$(version)).data.after == request.resource.data;
  }
  match /administration/{kind}/audit/{id} {
   allow read: if role('director') || role('technical');
   allow create: if kind == 'calendars' && (role('director') || role('technical')) && request.resource.data.keys().hasOnly(['id','actor','collection','recordId','at','before','after','reason']) && request.resource.data.id == id && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time && request.resource.data.collection == 'calendars' && request.resource.data.recordId == id && request.resource.data.before == null && text(request.resource.data.reason,2000) && request.resource.data.after == getAfter(/databases/$(database)/documents/calendars/$(id)).data && !exists(/databases/$(database)/documents/calendars/$(id));
   allow create: if (kind == 'profiles' && role('technical') || kind == 'assignments' && (role('director') || role('technical'))) && adminAudit();
   function adminAudit() { let a=request.resource.data; let p=/databases/$(database)/documents/users/$(a.recordId);
    return a.keys().hasOnly(['id','actor','collection','recordId','at','before','after','reason']) && a.id == id && a.collection == 'users' && ident(a.recordId) && a.actor == request.auth.uid && a.at == request.time && text(a.reason,2000)
     && id == a.recordId+'_'+string(a.after.revision) && a.after == getAfter(p).data && (exists(p) ? a.before == get(p).data && a.after.revision == a.before.revision+1 : a.before == null && a.after.revision == 1);
   }
  }
  match /{path=**} { allow read,write: if false; }
 }
}
