rules_version = '2';
// StockPro Spark: verified email invitations; separate private product costs.
// Business documents use numeric IDs, bounded strings and amounts. Every mutation
// advances meta/state and writes an immutable operation receipt. Sales, payments
// and cash history are append-only; stock/credit/invoice changes are coupled.
service cloud.firestore {
 match /databases/{database}/documents {
  function verified(){return request.auth!=null && request.auth.token.email_verified==true;}
  function email(){return request.auth.token.email.lower();}
  function membership(){return get(/databases/$(database)/documents/stockproAccess/$(email())).data;}
  function active(){return verified() && membership().active==true && membership().role in ['ADMIN','CAJERO','ENCARGADO','DUENO'];}
  function admin(){return active() && membership().role=='ADMIN';}
  function catalog(){return active() && membership().role in ['ADMIN','ENCARGADO'];}
  function cashier(){return active() && membership().role in ['ADMIN','CAJERO'];}
  function roleModule(id){let p=/databases/$(database)/documents/stockproConfig/modules;let defaults={'dashboard': ['ADMIN', 'ENCARGADO'], 'productos': ['ADMIN', 'ENCARGADO'], 'ventas': ['ADMIN', 'CAJERO'], 'clientes': ['ADMIN', 'CAJERO'], 'proveedores': ['ADMIN', 'ENCARGADO'], 'compras': ['ADMIN', 'ENCARGADO'], 'creditos': ['ADMIN', 'CAJERO'], 'facturacion': ['ADMIN'], 'caja': ['ADMIN', 'CAJERO'], 'movimientos': ['ADMIN', 'ENCARGADO'], 'usuarios': ['ADMIN', 'ENCARGADO']};let roles=exists(p)?get(p).data.get('roles',{}):{};return active()&&(membership().role=='DUENO'?id in ['dashboard','caja','usuarios']:membership().role=='ADMIN'||membership().role in roles.get(id,defaults[id]));}
  function validRoleList(r){return r is list&&r.size()<=3&&r.hasOnly(['ADMIN','CAJERO','ENCARGADO'])&&r.hasAll(['ADMIN'])&&r.toSet().size()==r.size();}
  function validRoleMap(r){return r is map&&r.keys().hasOnly(['dashboard', 'productos', 'ventas', 'clientes', 'proveedores', 'compras', 'creditos', 'facturacion', 'caja', 'movimientos', 'usuarios'])&&validRoleList(r.get('dashboard',['ADMIN']))&&validRoleList(r.get('productos',['ADMIN']))&&validRoleList(r.get('ventas',['ADMIN']))&&validRoleList(r.get('clientes',['ADMIN']))&&validRoleList(r.get('proveedores',['ADMIN']))&&validRoleList(r.get('compras',['ADMIN']))&&validRoleList(r.get('creditos',['ADMIN']))&&validRoleList(r.get('facturacion',['ADMIN']))&&validRoleList(r.get('caja',['ADMIN']))&&validRoleList(r.get('movimientos',['ADMIN']))&&validRoleList(r.get('usuarios',['ADMIN']));}
  function readCosts(){return roleModule('productos')||roleModule('compras')||(membership().role!='CAJERO'&&roleModule('dashboard'));}
  function readClients(){return storeOwner()||roleModule('clientes')||roleModule('creditos')||roleModule('ventas');}
  function readCredits(){return storeOwner()||roleModule('clientes')||roleModule('creditos')||roleModule('ventas');}
  function readStamps(){return roleModule('facturacion')||roleModule('ventas');}
  function readSales(){return roleModule('ventas')||roleModule('facturacion')||roleModule('caja');}
  function readCash(){return roleModule('caja')||roleModule('ventas')||roleModule('creditos');}
  function number(n){return n is number && n>=0 && n<=1000000000000000;}
  function text(s,n){return s is string && s.size()<=n;}
  function required(s,n){return text(s,n)&&s.size()>0;}
  function date(s){return text(s,10)&&s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');}
  // Despensas registry: ADMIN manages names and availability. Legacy accounts belong to Demo.
  function storeOwner(){return active()&&membership().role=='DUENO';}
  function memberStore(m){return m.get('storeId','despensa');}
  function assignedStore(id){let m=membership();return verified()&&m.active==true&&(m.role=='ADMIN'||m.role=='DUENO'&&id in m.get('storeIds',[])||m.role in ['CAJERO','ENCARGADO']&&id==m.get('storeId','despensa'));}
  function storeAvailable(id){let p=/databases/$(database)/documents/stockproDespensas/$(id);return id=='despensa'&&!exists(p)||get(p).data.active==true;}
  function validStoreId(id){return id is string&&id.size()>0&&id.size()<=80&&id.matches('^[a-zA-Z0-9_-]+$');}
  function validStore(d){return d.keys().hasOnly(['name','active','updatedBy','updatedAt','legacyMigrated'])&&required(d.name,100)&&d.active is bool&&d.get('legacyMigrated',false) is bool&&d.updatedBy==request.auth.uid&&d.updatedAt==request.time;}
  match /stockproDespensas/{id}{allow get:if assignedStore(id);allow list:if admin();allow create,update:if admin()&&validStoreId(id)&&validStore(request.resource.data);allow delete:if false;}
  function validAccess(d,id){return d.keys().hasOnly(['email','name','role','active','storeId','storeIds','updatedBy','updatedAt'])&&d.email==id&&required(d.name,200)&&d.role in ['ADMIN','CAJERO','ENCARGADO','DUENO']&&d.active is bool&&d.updatedBy==request.auth.uid&&d.updatedAt==request.time&&(
   d.role=='ADMIN'&&!('storeId' in d)&&!('storeIds' in d)
   ||d.role=='DUENO'&&!('storeId' in d)&&d.storeIds is list&&d.storeIds.size()>0&&d.storeIds.size()<=30&&d.storeIds.toSet().size()==d.storeIds.size()
   ||d.role in ['CAJERO','ENCARGADO']&&!('storeIds' in d)&&validStoreId(d.get('storeId',''))&&storeAvailable(d.storeId));}
  function operationalHere(d){return d.role in ['CAJERO','ENCARGADO']&&assignedStore(memberStore(d));}
  function manageable(id,d){return roleModule('usuarios')&&id!=email()&&id!=get(/databases/$(database)/documents/stockproConfig/main).data.ownerEmail&&(admin()||membership().role!='DUENO'&&operationalHere(d));}
  // Module settings: complete boolean map, timestamp and actor UID. Only the protected owner may change it.
  function superAdmin(){return admin()&&email()==get(/databases/$(database)/documents/stockproConfig/main).data.ownerEmail;}
  function enabledModule(id){let p=/databases/$(database)/documents/stockproConfig/modules;return !exists(p)||get(p).data.enabled[id];}
  function validModules(d){return d.keys().hasOnly(['enabled','roles','updatedBy','updatedAt'])&&validRoleMap(d.get('roles',{}))&&d.keys().hasAll(['enabled','updatedBy','updatedAt'])&&d.updatedBy==request.auth.uid&&d.updatedAt==request.time&&d.enabled is map&&d.enabled.keys().hasOnly(['dashboard', 'productos', 'ventas', 'clientes', 'proveedores', 'compras', 'creditos', 'facturacion', 'caja', 'movimientos', 'usuarios'])&&d.enabled.keys().hasAll(['dashboard', 'productos', 'ventas', 'clientes', 'proveedores', 'compras', 'creditos', 'facturacion', 'caja', 'movimientos', 'usuarios'])&&d.enabled.dashboard is bool&&d.enabled.productos is bool&&d.enabled.ventas is bool&&d.enabled.clientes is bool&&d.enabled.proveedores is bool&&d.enabled.compras is bool&&d.enabled.creditos is bool&&d.enabled.facturacion is bool&&d.enabled.caja is bool&&d.enabled.movimientos is bool&&d.enabled.usuarios is bool;}
  match /stockproConfig/{id}{allow read:if active();allow create,update:if id=='modules'&&superAdmin()&&validModules(request.resource.data);allow delete:if false;}

  match /stockproAccess/{id}{
   allow get:if verified()&&(id==email()||admin()||roleModule('usuarios')&&(!exists(/databases/$(database)/documents/stockproAccess/$(id))||operationalHere(resource.data)));
   allow list:if admin()||roleModule('usuarios')&&operationalHere(resource.data);
   allow create:if enabledModule('usuarios')&&validAccess(request.resource.data,id)&&manageable(id,request.resource.data);
   allow update:if enabledModule('usuarios')&&validAccess(request.resource.data,id)&&(
    manageable(id,request.resource.data)&&(admin()||operationalHere(resource.data))
    ||storeOwner()&&id!=email()&&operationalHere(resource.data)&&resource.data.active==true&&request.resource.data.active==false&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedBy','updatedAt']));
   allow delete:if false;
  }
  match /stockproStores/{storeId} {
   function storeAccess(){return assignedStore(storeId)&&storeAvailable(storeId);}
   function path(col,id){return /databases/$(database)/documents/stockproStores/$(storeId)/$(col)/$(string(id));}
   function meta(){return getAfter(path('meta','state')).data;}
   function oldRevision(){return exists(path('meta','state'))?get(path('meta','state')).data.revision:0;}
   function validMeta(d){return d.keys().hasOnly(['role','cashMoveId','closingId','action','opid','actorUid','saleId','creditId','paymentId','updatedAt','revision','schema'])&&d.role==membership().role&&text(d.cashMoveId,160)&&text(d.closingId,160)&&d.actorUid==request.auth.uid&&required(d.opid,100)&&required(d.action,40)&&number(d.saleId)&&number(d.creditId)&&text(d.paymentId,100)&&d.updatedAt==request.time&&d.revision==oldRevision()+1&&d.schema==9;}
   function actionAllowed(a){return membership().role!='DUENO'&&(a=='setCreditDueDate'?membership().role=='ENCARGADO'&&roleModule('clientes'):admin()||a in ['saveProduct', 'deleteProduct']&&roleModule('productos')||a in ['saveStockMove']&&roleModule('movimientos')||a in ['saveSupplier', 'deleteSupplier']&&roleModule('proveedores')||a in ['savePurchase']&&roleModule('compras')||a in ['finishSale']&&roleModule('ventas')||a in ['saveClient']&&roleModule('clientes')||a in ['saveCreditPayment']&&roleModule('creditos')||a in ['saveStamp', 'deleteStamp']&&roleModule('facturacion')||a in ['openCash', 'closeCash', 'addCashMove']&&roleModule('caja'));}
   function moduleAction(a){let m=exists(/databases/$(database)/documents/stockproConfig/modules)?get(/databases/$(database)/documents/stockproConfig/modules).data.enabled:{'dashboard':true,'productos':true,'ventas':true,'clientes':true,'proveedores':true,'compras':true,'creditos':true,'facturacion':true,'caja':true,'movimientos':true,'usuarios':true};return
    a in ['saveProduct','deleteProduct']&&m.productos
    ||a=='saveStockMove'&&m.productos&&m.movimientos
    ||a in ['saveSupplier','deleteSupplier']&&m.proveedores
    ||a=='savePurchase'&&m.compras
    ||a in ['saveClient','deleteClient','setCreditDueDate']&&m.clientes
    ||a=='saveCredit'&&m.creditos
    ||a=='saveCreditPayment'&&m.creditos&&(getAfter(path('payments',meta().paymentId)).data.method!='Efectivo'||m.caja)
    ||a in ['saveStamp','deleteStamp']&&m.facturacion
    ||a in ['openCash','closeCash','addCashMove']&&m.caja
    ||a=='finishSale'&&m.ventas&&m.caja&&(sale().invoice==null||m.facturacion)&&(sale().pay!='Crédito'||m.creditos)&&(sale().clientId==null||m.clientes)
    ||a=='restore'&&m.dashboard&&m.productos&&m.ventas&&m.clientes&&m.proveedores&&m.compras&&m.creditos&&m.facturacion&&m.caja&&m.movimientos&&m.usuarios;}
   // Each business mutation requires a newly authorized meta/state in this atomic request.
   // Tenant authorization lives there; repeating it per line exhausts the rules expression budget.
   function commit(){let m=meta();return m.actorUid==request.auth.uid&&m.revision==oldRevision()+1&&m.updatedAt==request.time;}
   function wAdmin(){return meta().role=='ADMIN';}
   function wCatalog(){return wAdmin()||meta().action in ['saveProduct','deleteProduct','saveStockMove','savePurchase'];}
   function wCashier(){return wAdmin()||meta().action in ['setCreditDueDate','finishSale','saveClient','saveCreditPayment','openCash','closeCash','addCashMove','saveStamp','deleteStamp'];}
   function wBilling(){return wAdmin()||meta().action in ['saveStamp','deleteStamp'];}
   function changed(d){return commit()&&d._op==meta().opid;}
   function act(a){return meta().action==a;}
   function sale(){return getAfter(path('sales',meta().saleId)).data;}
   function own(d){return d.operatorUid==request.auth.uid;}
   function validProduct(d){return d.keys().hasOnly(['id','sku','name','category','price','stock','min','avg','vat','_op','lastSaleId','lastSaleIndex'])&&number(d.id)&&required(d.sku,100)&&required(d.name,300)&&required(d.category,100)&&number(d.price)&&number(d.stock)&&number(d.min)&&number(d.avg)&&d.vat in [0,5,10];}
   function soldProduct(d,o){let items=sale().items;let i=items[d.lastSaleIndex];let prev=d.lastSaleIndex>0?items[d.lastSaleIndex-1].runningTotal:0;return act('finishSale')&&validLine(i)&&d.diff(o).affectedKeys().hasOnly(['stock','lastSaleId','lastSaleIndex','_op'])&&d.lastSaleId==meta().saleId&&i.productId==d.id&&i.price==o.price&&i.vat==o.vat&&i.runningTotal==prev+i.qty*i.price&&d.stock==o.stock-i.qty;}
   match /products/{id}{allow read:if storeAccess()&&(active());allow create:if (wAdmin()&&act('restore')||act('saveProduct')&&roleModule('productos'))&&changed(request.resource.data)&&validProduct(request.resource.data);allow update:if changed(request.resource.data)&&validProduct(request.resource.data)&&request.resource.data.id==resource.data.id&&(wCatalog()||wCashier()&&soldProduct(request.resource.data,resource.data));allow delete:if wCatalog()&&commit()&&(act('deleteProduct')||wAdmin()&&act('restore'));}
   function validCost(d){return d.keys().hasOnly(['id','cost','_op'])&&number(d.id)&&number(d.cost);}
   match /productCosts/{id}{allow read:if storeAccess()&&(readCosts());allow create,update:if (wAdmin()&&act('restore')||roleModule('productos')&&act('saveProduct')||roleModule('compras')&&act('savePurchase'))&&changed(request.resource.data)&&validCost(request.resource.data);allow delete:if commit()&&(wAdmin()&&act('restore')||roleModule('productos')&&act('deleteProduct'));}
   function validSupplier(d){return d.keys().hasOnly(['id','name','ruc','phone','contact','category','productIds','_op'])&&number(d.id)&&required(d.name,300)&&text(d.ruc,100)&&text(d.phone,100)&&text(d.contact,300)&&((!('category' in d)&&!('productIds' in d)&&act('restore'))||(required(d.category,100)&&d.productIds is list&&d.productIds.size()>0&&d.productIds.size()<=200&&d.productIds.toSet().size()==d.productIds.size()));}
   match /suppliers/{id}{allow read:if storeAccess()&&(roleModule('proveedores')||roleModule('compras'));allow create,update:if (wAdmin()&&act('restore')||roleModule('proveedores')&&act('saveSupplier'))&&changed(request.resource.data)&&validSupplier(request.resource.data);allow delete:if commit()&&(wAdmin()&&act('restore')||roleModule('proveedores')&&act('deleteSupplier'));}
   function validPurchase(d){return d.keys().hasOnly(['id','date','supplierId','supplier','productId','product','qty','cost','total','invoice','operatorUid','_op'])&&number(d.id)&&date(d.date)&&number(d.supplierId)&&text(d.supplier,300)&&number(d.productId)&&text(d.product,300)&&number(d.qty)&&number(d.cost)&&number(d.total)&&d.total==d.qty*d.cost&&text(d.invoice,100)&&text(d.get('operatorUid',''),128);}
   match /purchases/{id}{allow read:if storeAccess()&&(roleModule('compras'));allow create:if (wAdmin()&&act('restore')||act('savePurchase')&&roleModule('compras'))&&changed(request.resource.data)&&validPurchase(request.resource.data)&&(own(request.resource.data)||wAdmin()&&act('restore'));allow update,delete:if wAdmin()&&commit()&&act('restore')&&(request.resource==null||validPurchase(request.resource.data));}
   // Customer category and authorized outstanding-debt limit. Legacy categories are optional.
   function validClient(d){return d.keys().hasOnly(['id','name','doc','phone','address','category','limit','balance','_op'])&&number(d.id)&&required(d.name,300)&&text(d.doc,100)&&text(d.phone,100)&&text(d.address,500)&&number(d.limit)&&number(d.balance)&&(!('category' in d)||d.category in ['NUEVO','EXCELENTE','BUENO','MALO']&&d.limit<=({'NUEVO':300000,'EXCELENTE':300000,'BUENO':150000,'MALO':0})[d.category]);}
   function clientBalance(d,o){return act('finishSale')&&sale().clientId==d.id&&sale().pay=='Crédito'&&d.balance==o.balance+sale().total&&d.balance<=d.limit||act('saveCreditPayment')&&get(path('credits',meta().creditId)).data.clientId==d.id&&d.balance==o.balance-getAfter(path('payments',meta().paymentId)).data.amount;}
   function clientUpdate(d,o){let fields=d.diff(o).affectedKeys();return
    act('saveClient')&&(fields.hasOnly(['name','doc','phone','address','_op'])||membership().role=='ENCARGADO'&&fields.hasOnly(['name','doc','phone','address','category','limit','_op'])&&(!('category' in o)||'category' in d))
    ||fields.hasOnly(['balance','_op'])&&(clientBalance(d,o)||wAdmin()&&act('saveCredit'))
    ||wAdmin()&&act('restore')&&d.limit==o.limit&&d.get('category','')==o.get('category','');}
   match /clients/{id}{allow read:if storeAccess()&&(readClients());allow create:if wCashier()&&changed(request.resource.data)&&validClient(request.resource.data)&&(wAdmin()&&act('restore')||act('saveClient')&&request.resource.data.category=='NUEVO'&&request.resource.data.limit==300000&&request.resource.data.balance==0);allow update:if wCashier()&&changed(request.resource.data)&&validClient(request.resource.data)&&request.resource.data.id==resource.data.id&&clientUpdate(request.resource.data,resource.data);allow delete:if wAdmin()&&commit();}
   function dateValue(s){let p=s.split('-');return timestamp.date(int(p[0]),int(p[1]),int(p[2]));}
   function lastWeekday(t){let end=timestamp.date(t.month()==12?t.year()+1:t.year(),t.month()==12?1:t.month()+1,1)-duration.value(1,'d');return end-duration.value(end.dayOfWeek()>5?end.dayOfWeek()-5:0,'d');}
   function defaultDue(s){let d=dateValue(s);let last=lastWeekday(d);return last>=d?last:lastWeekday(d+duration.value(7,'d'));}
   function creditDue(d){return dateValue(d.dueDate)>=dateValue(d.date)&&(membership().role=='ENCARGADO'||dateValue(d.dueDate)==defaultDue(d.date));}
   function validLine(i){return i.keys().hasOnly(['productId','name','qty','price','vat','runningTotal'])&&number(i.productId)&&required(i.name,300)&&i.qty is int&&i.qty>0&&i.qty<=1000000&&number(i.price)&&i.vat in [0,5,10];}
   function lineOK(d,n){let i=d.items.size()>n?d.items[n]:null;let p=i==null?{}:getAfter(path('products',i.productId)).data;return i==null||p.lastSaleId==d.id&&p.lastSaleIndex==n;}
   function lineTotal(d,n){let i=d.items.size()>n?d.items[n]:{'qty':0,'price':0};return i.qty*i.price;}
   function total(d){return lineTotal(d,0)+lineTotal(d,1)+lineTotal(d,2)+lineTotal(d,3)+lineTotal(d,4)+lineTotal(d,5)+lineTotal(d,6)+lineTotal(d,7)+lineTotal(d,8)+lineTotal(d,9);}
   function validTaxes(t,v){return t.keys().hasOnly(['base10','iva10','base5','iva5','exempt','total'])&&number(t.base10)&&number(t.iva10)&&number(t.base5)&&number(t.iva5)&&number(t.exempt)&&t.total==v&&(t.base10+t.iva10+t.base5+t.iva5+t.exempt-v)<0.01&&(t.base10+t.iva10+t.base5+t.iva5+t.exempt-v)>-0.01;}
   function validInvoice(i){return i==null||i.keys().hasOnly(['enabled','doc','name','stampId','stamp','establishment','point','sequence','number','condition'])&&i.enabled==true&&required(i.doc,100)&&required(i.name,300)&&number(i.stampId)&&required(i.stamp,100)&&text(i.establishment,3)&&text(i.point,3)&&number(i.sequence)&&text(i.number,30)&&i.condition in ['CONTADO','CRÉDITO'];}
   function validSale(d){return d.keys().hasOnly(['id','date','datetime','operatorUid','cashSessionId','clientId','client','pay','total','taxes','invoice','items','creditId','_op'])&&number(d.id)&&date(d.date)&&text(d.datetime,40)&&text(d.get('operatorUid',''),128)&&text(d.cashSessionId,240)&&(d.clientId==null||number(d.clientId))&&required(d.client,300)&&d.pay in ['Efectivo','Transferencia','Tarjeta de débito','Tarjeta de crédito','Crédito']&&number(d.total)&&d.total>0&&d.items is list&&d.items.size()>0&&(d.items.size()<=10||wAdmin()&&act('restore')&&d.items.size()<=100)&&d.total==d.items[d.items.size()-1].runningTotal&&validTaxes(d.taxes,d.total)&&validInvoice(d.invoice);}
   function saleInvoice(d){return d.invoice==null||getAfter(path('stamps',d.invoice.stampId)).data.lastSaleId==d.id&&getAfter(path('stamps',d.invoice.stampId)).data.next==d.invoice.sequence+1;}
   function saleCredit(d){return d.pay!='Crédito'||getAfter(path('credits',d.creditId)).data.saleId==d.id&&getAfter(path('credits',d.creditId)).data.amount==d.total;}
   function checkedLines(d,n){return lineOK(d,n)&&lineOK(d,n+1)&&lineOK(d,n+2)&&lineOK(d,n+3)&&lineOK(d,n+4);}
   match /saleChecks/{id}{allow read:if storeAccess()&&(admin());allow create:if changed(request.resource.data)&&wCashier()&&request.resource.data.keys().hasOnly(['saleId','start','operatorUid','_op'])&&own(request.resource.data)&&request.resource.data.saleId==meta().saleId&&request.resource.data.start in [0,5]&&id==string(request.resource.data.saleId)+'_'+string(request.resource.data.start)&&checkedLines(sale(),request.resource.data.start);allow update,delete:if false;}
   function canSell(d){
    let m=meta();let c=get(path('cash',request.auth.uid)).data;
    let first=getAfter(path('saleChecks',string(d.id)+'_0')).data;
    return m.action=='finishSale'&&own(d)&&d.id==m.saleId&&c.isOpen&&d.cashSessionId==c.sessionId&&getAfter(path('cash',request.auth.uid)).data._op==m.opid&&first.saleId==d.id&&(d.items.size()<=5||getAfter(path('saleChecks',string(d.id)+'_5')).data.saleId==d.id)&&saleInvoice(d)&&saleCredit(d);
   }
   match /sales/{id}{allow read:if storeAccess()&&(admin()||storeOwner()||readSales()&&own(resource.data));allow create:if changed(request.resource.data)&&validSale(request.resource.data)&&(wAdmin()&&act('restore')||canSell(request.resource.data));allow update,delete:if false;}
   function validCredit(d){return d.keys().hasOnly(['id','clientId','client','date','dueDate','amount','balance','note','operatorUid','saleId','lastPaymentId','_op'])&&number(d.id)&&number(d.clientId)&&required(d.client,300)&&date(d.date)&&date(d.dueDate)&&number(d.amount)&&number(d.balance)&&d.balance<=d.amount&&text(d.note,1000)&&text(d.get('operatorUid',''),128)&&text(d.get('lastPaymentId',''),100);}
   match /credits/{id}{allow read:if storeAccess()&&(readCredits());allow create:if wCashier()&&changed(request.resource.data)&&validCredit(request.resource.data)&&(wAdmin()&&act('restore')||creditDue(request.resource.data)&&(wAdmin()&&act('saveCredit')||act('finishSale')&&own(request.resource.data)&&request.resource.data.saleId==meta().saleId&&sale().pay=='Crédito'&&sale().creditId==request.resource.data.id&&request.resource.data.clientId==sale().clientId&&request.resource.data.amount==sale().total&&request.resource.data.balance==request.resource.data.amount&&getAfter(path('clients',request.resource.data.clientId)).data.balance==get(path('clients',request.resource.data.clientId)).data.balance+request.resource.data.amount));
    allow update:if wCashier()&&changed(request.resource.data)&&validCredit(request.resource.data)&&(
     act('setCreditDueDate')&&membership().role=='ENCARGADO'&&resource.data.balance>0&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueDate','_op'])&&dateValue(request.resource.data.dueDate)>=dateValue(resource.data.date)
     ||wAdmin()&&meta().action in ['saveCredit','restore']&&request.resource.data.dueDate==resource.data.dueDate
     ||act('saveCreditPayment')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','lastPaymentId','_op'])&&request.resource.data.lastPaymentId==meta().paymentId&&request.resource.data.balance==resource.data.balance-getAfter(path('payments',meta().paymentId)).data.amount);
    allow delete:if wAdmin()&&commit()&&act('restore');}
   function validPayment(d){return d.keys().hasOnly(['date','amount','method','detail','operatorUid','creditId','position','_op'])&&date(d.date)&&number(d.amount)&&d.amount>0&&d.method in ['Efectivo','Transferencia','Tarjeta de débito','Tarjeta de crédito']&&text(d.detail,500)&&text(d.get('operatorUid',''),128)&&number(d.creditId)&&d.position is int&&d.position>=0;}
   match /payments/{id}{allow read:if storeAccess()&&(readCredits());allow create:if wCashier()&&changed(request.resource.data)&&validPayment(request.resource.data)&&(wAdmin()&&act('restore')||act('saveCreditPayment')&&own(request.resource.data)&&id==meta().paymentId&&request.resource.data.creditId==meta().creditId&&getAfter(path('credits',meta().creditId)).data.balance==get(path('credits',meta().creditId)).data.balance-request.resource.data.amount&&getAfter(path('clients',get(path('credits',meta().creditId)).data.clientId)).data.balance==get(path('clients',get(path('credits',meta().creditId)).data.clientId)).data.balance-request.resource.data.amount&&(request.resource.data.method!='Efectivo'||get(path('cash',request.auth.uid)).data.isOpen&&getAfter(path('cash',request.auth.uid)).data._op==meta().opid));allow update,delete:if false;}
   function validStamp(d){return d.keys().hasOnly(['id','number','establishment','point','validFrom','validTo','start','end','next','enabled','note','lastSaleId','_op'])&&number(d.id)&&required(d.number,100)&&d.establishment.matches('^[0-9]{3}$')&&d.point.matches('^[0-9]{3}$')&&date(d.validFrom)&&date(d.validTo)&&d.start is int&&d.end is int&&d.next is int&&d.start>=1&&d.end>=d.start&&d.end<=9999999&&d.next>=d.start&&d.next<=d.end+1&&d.enabled is bool&&text(d.note,1000);}
   function invoiceAdvance(d,o){return act('finishSale')&&d.diff(o).affectedKeys().hasOnly(['next','lastSaleId','_op'])&&o.enabled&&d.next==o.next+1&&d.lastSaleId==meta().saleId&&sale().invoice.stampId==d.id&&sale().invoice.sequence==o.next&&sale().invoice.stamp==o.number&&sale().invoice.establishment==o.establishment&&sale().invoice.point==o.point&&sale().date>=o.validFrom&&sale().date<=o.validTo;}
   match /stamps/{id}{allow read:if storeAccess()&&(readStamps());allow create:if wBilling()&&changed(request.resource.data)&&validStamp(request.resource.data);allow update:if wCashier()&&changed(request.resource.data)&&validStamp(request.resource.data)&&request.resource.data.id==resource.data.id&&(wBilling()&&request.resource.data.next>=resource.data.next||invoiceAdvance(request.resource.data,resource.data));allow delete:if wBilling()&&commit()&&resource.data.next==resource.data.start;}
   function validCash(d){return d.keys().hasOnly(['isOpen','openedAt','openingAmount','sessionId','operatorUid','operatorEmail','expectedBalance','_op'])&&d.isOpen is bool&&(d.openedAt==null||text(d.openedAt,40))&&number(d.openingAmount)&&(d.sessionId==null||text(d.sessionId,240))&&d.operatorUid==request.auth.uid&&d.operatorEmail==email()&&d.expectedBalance is number&&d.expectedBalance>=-1000000000000000&&d.expectedBalance<=1000000000000000;}
   function cashTransition(d){
    let old=exists(path('cash',request.auth.uid))?get(path('cash',request.auth.uid)).data:{'isOpen':false,'expectedBalance':0};
    let fixed=old.isOpen&&d.sessionId==old.sessionId&&d.openedAt==old.openedAt&&d.openingAmount==old.openingAmount;
    return wAdmin()&&act('restore')||act('openCash')&&!old.isOpen&&d.isOpen&&d.expectedBalance==d.openingAmount&&d.sessionId==request.auth.uid+':'+meta().opid
     ||act('closeCash')&&old.isOpen&&!d.isOpen&&d.openedAt==null&&d.openingAmount==0&&d.expectedBalance==0&&getAfter(path('cashClosings',meta().closingId)).data.expected==old.expectedBalance
     ||fixed&&d.isOpen&&(act('finishSale')&&sale()._op==meta().opid&&d.expectedBalance==old.expectedBalance+(sale().pay=='Efectivo'?sale().total:0)
     ||act('saveCreditPayment')&&getAfter(path('payments',meta().paymentId)).data._op==meta().opid&&d.expectedBalance==old.expectedBalance+(getAfter(path('payments',meta().paymentId)).data.method=='Efectivo'?getAfter(path('payments',meta().paymentId)).data.amount:0)
     ||act('addCashMove')&&getAfter(path('cashMoves',meta().cashMoveId)).data._op==meta().opid&&d.expectedBalance==old.expectedBalance+(getAfter(path('cashMoves',meta().cashMoveId)).data.type=='INGRESO'?getAfter(path('cashMoves',meta().cashMoveId)).data.amount:-getAfter(path('cashMoves',meta().cashMoveId)).data.amount));
   }
   match /cash/{uid}{allow read:if storeAccess()&&(admin()||storeOwner()||readCash()&&uid==request.auth.uid);allow create,update:if wCashier()&&uid==request.auth.uid&&changed(request.resource.data)&&validCash(request.resource.data)&&cashTransition(request.resource.data);allow delete:if false;}
   function validCashMove(d){return d.keys().hasOnly(['id','date','datetime','amount','type','detail','cashSessionId','operatorUid','paymentId','_op'])&&number(d.id)&&date(d.date)&&text(d.datetime,40)&&number(d.amount)&&d.amount>0&&d.type in ['INGRESO','EGRESO']&&required(d.detail,500)&&text(d.cashSessionId,240)&&text(d.get('operatorUid',''),128)&&text(d.get('paymentId',''),100);}
   match /cashMoves/{id}{allow read:if storeAccess()&&(admin()||storeOwner()||readCash()&&own(resource.data));allow create:if wCashier()&&changed(request.resource.data)&&validCashMove(request.resource.data)&&(wAdmin()&&act('restore')||own(request.resource.data)&&id==meta().cashMoveId&&getAfter(path('cash',request.auth.uid)).data._op==meta().opid&&get(path('cash',request.auth.uid)).data.isOpen&&request.resource.data.cashSessionId==get(path('cash',request.auth.uid)).data.sessionId&&(act('addCashMove')||act('saveCreditPayment')&&request.resource.data.paymentId==meta().paymentId&&request.resource.data.amount==getAfter(path('payments',meta().paymentId)).data.amount));allow update,delete:if false;}
   function validClosing(d){return d.keys().hasOnly(['id','date','openedAt','closedAt','openingAmount','expected','declared','difference','cashSessionId','operatorUid','_op'])&&number(d.id)&&date(d.date)&&text(d.openedAt,40)&&text(d.closedAt,40)&&number(d.openingAmount)&&d.expected is number&&number(d.declared)&&d.difference==d.declared-d.expected&&text(d.cashSessionId,240)&&text(d.get('operatorUid',''),128);}
   match /cashClosings/{id}{allow read:if storeAccess()&&(admin()||storeOwner()||readCash()&&own(resource.data));allow create:if wCashier()&&changed(request.resource.data)&&validClosing(request.resource.data)&&(wAdmin()&&act('restore')||act('closeCash')&&id==meta().closingId&&own(request.resource.data)&&get(path('cash',request.auth.uid)).data.isOpen&&request.resource.data.cashSessionId==get(path('cash',request.auth.uid)).data.sessionId&&request.resource.data.expected==get(path('cash',request.auth.uid)).data.expectedBalance&&!getAfter(path('cash',request.auth.uid)).data.isOpen);allow update,delete:if false;}
   function validMove(d){return d.keys().hasOnly(['id','date','datetime','productId','product','type','qty','detail','operatorUid','_op'])&&number(d.id)&&date(d.date)&&text(d.datetime,40)&&number(d.productId)&&text(d.product,300)&&d.type in ['ENTRADA','SALIDA','AJUSTE']&&d.qty is number&&d.qty>=-1000000000000000&&d.qty<=1000000000000000&&text(d.detail,500)&&text(d.get('operatorUid',''),128);}
   function saleMove(d){let p=getAfter(path('products',d.productId)).data;return p.lastSaleId==meta().saleId&&d.qty==-sale().items[p.lastSaleIndex].qty;}
   match /moves/{id}{allow read:if storeAccess()&&(roleModule('movimientos')||roleModule('productos'));allow create:if changed(request.resource.data)&&validMove(request.resource.data)&&(wCatalog()||wCashier()&&act('finishSale')&&own(request.resource.data)&&request.resource.data.type=='SALIDA'&&request.resource.data.qty<0&&saleMove(request.resource.data));allow update,delete:if wAdmin()&&commit()&&act('restore')&&(request.resource==null||validMove(request.resource.data));}
   match /meta/state{allow read:if storeAccess()&&(active());allow create,update:if storeAccess()&&(active()&&validMeta(request.resource.data)&&actionAllowed(request.resource.data.action)&&moduleAction(request.resource.data.action)&&getAfter(path('operations',request.auth.uid+'_'+request.resource.data.opid)).data.revision==request.resource.data.revision);allow delete:if storeAccess()&&(false);}
   match /operations/{id}{allow read:if storeAccess()&&(admin()||active()&&resource.data.actorUid==request.auth.uid);allow get:if storeAccess()&&(active()&&id.matches(request.auth.uid+'_.*'));allow create:if storeAccess()&&(active()&&id==request.auth.uid+'_'+request.resource.data.opid&&request.resource.data.keys().hasOnly(['role','cashMoveId','closingId','action','opid','actorUid','saleId','creditId','paymentId','updatedAt','revision'])&&request.resource.data.actorUid==request.auth.uid&&request.resource.data.updatedAt==request.time&&request.resource.data.revision==meta().revision&&request.resource.data.opid==meta().opid&&request.resource.data.action==meta().action);allow update,delete:if storeAccess()&&(false);}
  }
  match /{doc=**}{allow read,write:if false;}
 }
}
