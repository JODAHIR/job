rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/closures/{date} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['data', 'revision', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.meta.date == date
        && request.resource.data.data.modules is map
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
      match /pdfs/{pdfId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['id', 'name', 'size', 'contentType', 'detectedDate', 'module', 'createdAt', 'path', 'url', 'uploadedAt'])
          && request.resource.data.id == pdfId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 255
          && request.resource.data.size is int
          && request.resource.data.size > 0
          && request.resource.data.size <= 20 * 1024 * 1024
          && request.resource.data.contentType == 'application/pdf'
          && request.resource.data.path == 'users/' + uid + '/closures/' + date + '/pdfs/' + pdfId + '.pdf'
          && request.resource.data.uploadedAt == request.time;
      }
    }
  }
}
