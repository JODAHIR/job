// procedimientos: validated operational records; only published records may be read by approved users.
// authorized_users/{lowercase email}: admin-managed consultation access; users can read only their own status.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'javier.odahir@gmail.com';
    }
    function approved() {
      return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower())).data.active == true;
    }
    match /authorized_users/{email} {
      allow get: if owner() || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == email);
      allow list: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['email','active','updatedAt','updatedBy'])
        && request.resource.data.keys().hasOnly(['email','active','updatedAt','updatedBy'])
        && request.resource.data.email is string && request.resource.data.email == email
        && email == email.lower() && email.size() <= 254
        && email.matches('[^ /@]+@[^ /@]+[.][^ /@]+')
        && email != 'javier.odahir@gmail.com'
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    function valid(d) {
      return d.keys().hasAll(['title','questions','support','steps','hours','good','bad','published','keywords','updatedAt'])
        && d.keys().hasOnly(['category','title','questions','support','steps','hours','good','bad','published','keywords','updatedAt','revisionId'])
        && (!('category' in d) || (d.category is string && d.category.size() > 0 && d.category.size() <= 100))
        && d.revisionId is string && d.revisionId.size() == 36
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.steps is string && d.steps.size() > 0 && d.steps.size() <= 10000
        && d.questions is string && d.questions.size() <= 3000
        && d.support is string && d.support.size() <= 500
        && d.hours is string && d.hours.size() <= 500
        && d.good is string && d.good.size() <= 3000
        && d.bad is string && d.bad.size() <= 3000
        && d.published is bool && d.keywords is list && d.keywords.size() <= 100
        && d.updatedAt == request.time;
    }
    match /procedimientos/{id} {
      allow read: if owner() || (approved() && resource.data.published == true);
      allow create, update: if owner() && valid(request.resource.data)
        && getAfter(/databases/$(database)/documents/procedure_history/$(request.resource.data.revisionId)).data.after == request.resource.data
        && getAfter(/databases/$(database)/documents/procedure_history/$(request.resource.data.revisionId)).data.procedureId == id
        && getAfter(/databases/$(database)/documents/procedure_history/$(request.resource.data.revisionId)).data.changedAt == request.time;
      allow delete: if false;
    }
    // Immutable revisions are created atomically with their procedure.
    match /procedure_history/{revision} {
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasAll(['procedureId','before','after','changedAt','changedBy','changedEmail'])
        && request.resource.data.keys().hasOnly(['procedureId','before','after','changedAt','changedBy','changedEmail'])
        && request.resource.data.procedureId is string
        && request.resource.data.procedureId.size() > 0 && request.resource.data.procedureId.size() <= 128
        && request.resource.data.changedAt == request.time
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.changedEmail == request.auth.token.email
        && valid(request.resource.data.after)
        && request.resource.data.after.revisionId == revision
        && request.resource.data.after == getAfter(/databases/$(database)/documents/procedimientos/$(request.resource.data.procedureId)).data
        && ((!exists(/databases/$(database)/documents/procedimientos/$(request.resource.data.procedureId)) && request.resource.data.before == null)
          || request.resource.data.before == get(/databases/$(database)/documents/procedimientos/$(request.resource.data.procedureId)).data);
      allow update, delete: if false;
    }
  }
}
